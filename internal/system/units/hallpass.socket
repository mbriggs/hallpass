# Written by hallpass install. The control socket: status and signing.
[Unit]
Description=hallpass broker control socket

[Socket]
ListenStream=/run/hallpass/hallpass.sock
FileDescriptorName=hallpass
Service=hallpass.service
# Anyone can connect. The broker checks each client's uid against the config.
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
