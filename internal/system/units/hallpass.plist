<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by hallpass install. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.mbriggs.hallpass</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/hallpass/bin/hallpass</string>
    <string>serve</string>
  </array>
  <key>UserName</key>
  <string>_hallpass</string>
  <key>GroupName</key>
  <string>_hallpass</string>
  <!-- launchd has no memory cap. The broker checks one push at a time, so
       it holds about 3 GB at most, and GOMEMLIMIT makes Go collect garbage
       before its heap doubles past that. hallpass.service explains the
       numbers. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>GOMEMLIMIT</key>
    <string>3500MiB</string>
  </dict>
  <key>Umask</key>
  <integer>63</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/var/log/hallpass.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/hallpass.log</string>
</dict>
</plist>
