# Written by hallpass install.
[Unit]
Description=hallpass GitHub credential broker
Requires=hallpass.socket hallpass-gh.socket hallpass-ssh.socket
After=hallpass.socket hallpass-gh.socket hallpass-ssh.socket network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/hallpass/bin/hallpass serve
Sockets=hallpass.socket hallpass-gh.socket hallpass-ssh.socket
User=hallpass
Group=hallpass
# /dev/tpmrm0 belongs to the tss group.
SupplementaryGroups=tss
StateDirectory=hallpass
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
# journald drops lines past its rate limit, so a flood of cheap refusals
# could hide a real request. Keep every line instead.
LogRateLimitIntervalSec=0
# Each push the broker checks can hold its pack, up to 512 MB, and the
# commits and trees in it, up to 1 GB. Cap the total, so a client sending
# many large pushes at once runs the broker out of memory, and systemd
# restarts it, instead of the kernel killing the user's other processes.
MemoryMax=4G

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
