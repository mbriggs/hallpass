# Written by hallpass install.
[Unit]
Description=hallpass GitHub credential broker
Requires=hallpass.socket hallpass-gh.socket hallpass-ssh.socket
After=hallpass.socket hallpass-gh.socket hallpass-ssh.socket network-online.target
Wants=network-online.target

[Service]
ExecStart=/opt/hallpass/bin/hallpass serve
Sockets=hallpass.socket hallpass-gh.socket hallpass-ssh.socket
User=hallpass
Group=hallpass
# /dev/tpmrm0 belongs to the tss group.
SupplementaryGroups=tss
StateDirectory=hallpass
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
# journald drops lines past its rate limit, so a flood of cheap refusals
# could hide a real request. Keep every line instead.
LogRateLimitIntervalSec=0
# Pushed packs wait on disk in the state dir. The broker checks one push at
# a time, and a check holds at most about 2 GB: up to 1 GB of commits and
# trees from the pack, and up to 1 GB more fetched from GitHub. Each of the
# 64 connections adds up to about 10 MB of buffers. Cap the total, so a
# miscount makes systemd restart the broker instead of the kernel killing
# the user's other processes. Go lets its heap grow to twice what's live
# before collecting, so GOMEMLIMIT makes it collect sooner near the cap.
MemoryMax=4G
Environment=GOMEMLIMIT=3500MiB

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
DevicePolicy=closed
DeviceAllow=/dev/tpmrm0 rw
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
