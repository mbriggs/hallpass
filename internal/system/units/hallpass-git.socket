# Written by hallpass install. The socket for git over HTTPS (SOCKS5).
[Unit]
Description=hallpass broker socket for git over HTTPS (SOCKS5)

[Socket]
ListenStream=/run/hallpass/git.sock
FileDescriptorName=git
Service=hallpass.service
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
